{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "steyg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "STEYG Code",
      "options": {
        "baseURL": "https://steyg.one/api/v1",
        "apiKey": "{env:STEYG_CODE_API_KEY}"
      },
      "models": {
        "MODEL_ID": {
          "name": "MODEL_ID",
          "limit": { "context": 200000, "output": 32000 }
        }
      }
    }
  }
}
